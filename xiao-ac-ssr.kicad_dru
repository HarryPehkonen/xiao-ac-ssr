(version 1)
(rule "mains isolation barrier (mains vs logic, 3 mm)"
	(constraint clearance (min 3mm))
	(condition "(A.NetName =~ '^/?(L_IN|L_FUSED|N_AC|LOAD_L|MOC_MT2|TRIAC_G)$' && !(B.NetName =~ '^/?(L_IN|L_FUSED|N_AC|LOAD_L|MOC_MT2|TRIAC_G)$')) || (B.NetName =~ '^/?(L_IN|L_FUSED|N_AC|LOAD_L|MOC_MT2|TRIAC_G)$' && !(A.NetName =~ '^/?(L_IN|L_FUSED|N_AC|LOAD_L|MOC_MT2|TRIAC_G)$'))"))
(rule "mains track width"
	(constraint track_width (min 1.5mm))
	(condition "A.NetName =~ '^/?(L_IN|L_FUSED|N_AC|LOAD_L|MOC_MT2|TRIAC_G)$'"))
